# =====================================================================
# DARA FREE — contoh konfigurasi server
#
# Salin berkas ini menjadi ".env" lalu isi nilainya:
#     cp .env.example .env        (Linux/macOS)
#     copy .env.example .env      (Windows)
#
# Installer (npm run setup di folder induk) menulis berkas .env ini
# secara otomatis — Anda hanya perlu menyuntingnya bila ada yang berubah.
#
# JANGAN commit berkas .env ke git (sudah masuk .gitignore).
# =====================================================================

# ---- Driver database ------------------------------------------------
# mysql  : rekomendasi, dipakai installer
# sqlite : coba cepat tanpa memasang server database (berkas .db lokal)
DB_TYPE=mysql

# ---- Koneksi MySQL --------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dara
MYSQL_PASSWORD=ganti-password-ini
MYSQL_DATABASE=dara_free
# Jumlah koneksi maksimum dalam pool. Naikkan bila banyak pengguna bersamaan.
MYSQL_POOL_MAX=10

# ---- SQLite (hanya dipakai bila DB_TYPE=sqlite) ---------------------
DB_PATH=./dara.db

# ---- Filter tabel ---------------------------------------------------
# Hanya tabel berawalan ini yang muncul di menu "Jelajah Data".
# Ini yang menjaga tabel metadata (dara_charts, dara_users, ...) tetap
# tersembunyi dari pengguna. Kosongkan untuk menampilkan semua tabel
# non-metadata.
DB_TABLE_PREFIX=dara_data_

# ---- Penyimpanan metadata -------------------------------------------
# mysql : chart/dashboard/story/user disimpan di tabel dara_*  (default)
# file  : disimpan sebagai JSON di server/data/  (tanpa database)
META_STORE=mysql

# ---- Server ---------------------------------------------------------
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# Sajikan hasil build client dari server yang sama (produksi satu port).
# Setel true setelah menjalankan "npm run build" di folder client.
SERVE_STATIC=false

# Daftar origin yang boleh memanggil API, dipisah koma.
# Saat development client Vite berjalan di port 5173.
CORS_ORIGINS=http://localhost:5173

# ---- Keamanan -------------------------------------------------------
# Kunci penandatangan JWT. WAJIB diganti dengan string acak panjang.
# Cara membuat:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Kunci enkripsi password koneksi database eksternal (menu Data Connection).
# WAJIB 64 karakter heksadesimal (32 byte). DIBUAT OTOMATIS oleh installer
# (installer/index.js) — Anda TIDAK perlu mengisi ini manual kalau memasang
# lewat install.bat/install.sh. Baris di bawah ini cuma placeholder untuk
# instalasi MANUAL (tanpa installer) atau bila Anda perlu membuat ulang.
# Tanpa ini, dev mode memakai kunci turunan sementara dari JWT_SECRET
# (peringatan di console) — TIDAK untuk produksi. JANGAN diganti setelah ada
# koneksi tersimpan (koneksi lama jadi tidak bisa didekripsi).
# Cara membuat manual:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONN_SECRET_KEY=ganti-dengan-64-karakter-hex-acak

# Driver Oracle (menu Data Connection) — OPSIONAL, isi HANYA kalau server
# Oracle Anda versi LAMA (11g/11.2 ke bawah). Mode bawaan node-oracledb
# ("thin") cuma mendukung Oracle Database 12.1+ — konek ke versi lebih
# lama akan gagal dengan error "NJS-138: connections to this database
# server version are not supported by node-oracledb in Thin mode".
# Solusinya: pasang Oracle Instant Client di mesin server DARA ini
# (unduh dari oracle.com, format Basic/Basic Light, tinggal diekstrak —
# bukan lewat npm), lalu isi path folder hasil ekstraknya di sini.
# Kosongkan/hapus baris ini kalau server Oracle Anda 12.1+ (mayoritas
# kasus) — mode thin sudah cukup, tidak perlu Instant Client sama sekali.
# ORACLE_CLIENT_LIB_DIR=/path/ke/instantclient_21_x
