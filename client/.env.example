# =====================================================================
# DARA FREE — konfigurasi client (Vite)
#
# Salin menjadi ".env". Installer menulis berkas ini otomatis.
# Semua kunci Vite WAJIB berawalan VITE_ agar ikut ter-bundle.
# =====================================================================

# Alamat backend DARA. Dipakai sebagai target proxy saat `npm run dev`.
VITE_API_URL=http://localhost:3001

# Port dev server Vite.
VITE_PORT=5173
